# The edge. Each app is served on its own origin together with the API paths it
# calls, so session cookies are host-only and no browser request is
# cross-origin. web/serve.js does the same routing for `make prod` locally.
#
#   id.mywebsite.com        web/id + provider and account API (api:8080)
#   admin-id.mywebsite.com  web/console + admin API (api:8081), staff only
#
# Caddy manages TLS itself. Replace the hostnames, email and staff networks.

{
	email ops@mywebsite.com
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	encode zstd gzip

	# Nothing either site takes is a file: every request body is a form or a
	# JSON document, and the largest of them — a language imported on the
	# console's Languages page — is tens of kilobytes. A body past this is
	# refused here rather than held in the API's memory.
	request_body {
		max_size 1MB
	}
}

id.mywebsite.com {
	import hardening

	# The provider and the users' API go to the public listener. Nothing under
	# /api/v1/admin exists there, so it cannot be reached through this site.
	@api path /oauth2/* /.well-known/* /api/v1/account/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy id:3000
	}
}

admin-id.mywebsite.com {
	import hardening

	# Staff only. Anyone not on these networks is refused here, before a
	# request reaches the panel or the admin API. Better still: give this host
	# no public DNS at all and reach it over a VPN (WireGuard, Tailscale) or an
	# identity-aware proxy (Cloudflare Access, Pomerium), and keep this list as
	# a second lock.
	@outsiders not remote_ip 10.8.0.0/24 203.0.113.10/32
	respond @outsiders "Not found" 404

	@api path /api/v1/admin/*
	handle @api {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy console:3000
	}
}
