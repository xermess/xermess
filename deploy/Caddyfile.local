# The edge for a local trial of the production stack, used instead of
# Caddyfile by compose.local.yaml. Same two sites and the same routing; what
# differs is only what cannot work on one machine.
#
#   https://id.localhost        web/id + provider and account API (api:8080)
#   https://admin-id.localhost  web/console + admin API (api:8081)
#
# Chrome and Firefox resolve *.localhost to 127.0.0.1 themselves, so there is
# nothing to add to /etc/hosts.

{
	# Caddy's own CA signs these, rather than Let's Encrypt, which has no way
	# to reach a name like this. The browser will not know that CA, so expect
	# a warning. To silence it, take the root out of the container and trust
	# it — see the foot of this file.
	local_certs
}

(hardening) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	encode zstd gzip

	request_body {
		max_size 1MB
	}
}

# No Strict-Transport-Security here, unlike Caddyfile. A browser remembers it
# per host and for two years: one trial would pin id.localhost to https long
# after this stack is gone, and anything else served there later would break.

id.localhost {
	import hardening

	@api path /oauth2/* /.well-known/* /api/v1/account/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy id:3000
	}
}

# The staff site, without the remote_ip restriction Caddyfile has. Locally
# every request arrives from the Docker gateway rather than from a staff
# network, so that check would answer 404 to the person running the stack —
# which is why this file exists and why it is not for a server.
admin-id.localhost {
	import hardening

	@api path /api/v1/admin/*
	handle @api {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy console:3000
	}
}

# Trusting the CA, if the warning is in the way. The root lives in the caddy
# volume; this copies it out and adds it to the system store (Debian/Ubuntu),
# after which the browser is quiet:
#
#   docker compose -f deploy/compose.yaml -f deploy/compose.local.yaml cp \
#     caddy:/data/caddy/pki/authorities/local/root.crt /tmp/caddy-local-root.crt
#   sudo cp /tmp/caddy-local-root.crt /usr/local/share/ca-certificates/
#   sudo update-ca-certificates
#
# Firefox keeps its own store and ignores the system one: either import the
# same file under Settings > Privacy > Certificates, or set
# security.enterprise_roots.enabled to true in about:config.
