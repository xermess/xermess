# The public listener: the OAuth 2.0 / OpenID Connect provider and the account
# API the id app calls. In production only the reverse proxy reaches it.
XERMESS_ADDR=:8080

# The admin listener: the admin API, and nothing else. Never publish this port
# to the internet: bind it to an internal address, or leave it unpublished, so
# only the console's network reaches it.
XERMESS_ADMIN_ADDR=:8081

# The provider's public URL: the iss of every token, and the base of every URL
# in /.well-known/openid-configuration. It is the id app's origin, which
# serves the provider paths through its proxy — in development Vite's, in
# production the reverse proxy's (deploy/Caddyfile).
XERMESS_ISSUER=http://localhost:5173

# Where the id app is served. Leave it unset to use the issuer, which is the
# recommended setup: one origin for the provider and the users' app.
# XERMESS_ACCOUNT_URL=

# Where the console is served. Only its origin may change anything through the
# admin API.
XERMESS_ADMIN_URL=http://localhost:5174

# Session cookies are Secure when the URLs above are https, which is what a
# deployment wants; set this only to override that.
# XERMESS_SECURE_COOKIES=

# Extra browser origins allowed to call the cookie-authenticated APIs from
# script. With each app on the same origin as its API, none is needed: every
# origin listed here can act as whoever is signed in.
XERMESS_CORS_ORIGINS=

# Addresses or CIDR ranges of the reverse proxies in front of the API, comma
# separated, whose X-Forwarded-For header is trusted. Empty trusts none. Behind
# a proxy this has to be set, or every request looks like the proxy's — to the
# activity log, and to the rate limit.
XERMESS_TRUSTED_PROXIES=

# Attempts per minute one address may make at the endpoints that take a
# password or send an email. 0 turns the limit off.
XERMESS_RATE_LIMIT=20

# What a fresh installation starts with for administrators' two-factor
# sign-in: optional (each administrator turns one on for themselves, from
# their profile) or required (every one of them sets up an authenticator app
# at their next sign-in).
#
# It is read once, on the first start, and written to the database. After that
# the setting is the panel's — Administrators · Two-factor sign-in — and
# changing this line does nothing.
XERMESS_ADMIN_MFA=optional

# Days a token signing key signs before the next one takes over. 0 never
# rotates on its own.
XERMESS_KEY_ROTATION_DAYS=90

# Days the activity log keeps an entry. Expired sessions, codes and tokens are
# swept every hour; without a limit the log would be the one table that grew
# with every sign-in forever. 0 keeps every entry.
XERMESS_AUDIT_RETENTION_DAYS=365

# Encrypts the private keys tokens are signed with. At least 32 characters;
# make one with `openssl rand -base64 32`. `make setup` writes one for you.
# Changing it makes the stored keys unreadable, which signs everyone out.
XERMESS_SECRET_KEY=

# Where password reset emails are sent from. With no host, emails are written
# to the server's log instead, which is enough while developing.
XERMESS_SMTP_HOST=
XERMESS_SMTP_PORT=587
XERMESS_SMTP_USERNAME=
XERMESS_SMTP_PASSWORD=
XERMESS_SMTP_FROM=xermess <no-reply@localhost>

XERMESS_DB_DSN=postgres://postgres:postgres@localhost:5432/xermess?sslmode=disable
XERMESS_DB_DRIVER=postgres
XERMESS_DB_TIMEZONE=Asia/Bishkek
XERMESS_DB_LOG_QUERIES=false
XERMESS_DB_MIGRATE=true
XERMESS_DB_MIGRATE_DIR=./migrations
# Connections one server process may hold to the database. Every process
# together has to stay under Postgres's own max_connections (100 by default):
# with three API processes, 25 each leaves room for the migration tool and a
# psql session.
XERMESS_DB_MAX_CONNS=25

# Redis: the cache in front of the reads every page makes — the languages and
# their text, the organisation, the login flows, the sign-in buttons — and
# where the rate limit counts, so every server process shares one limit.
# Leave XERMESS_REDIS_HOST empty to run without it: every read then goes to
# the database and each process counts on its own. A host that is set but
# does not answer stops the server at startup.
XERMESS_REDIS_HOST=localhost
XERMESS_REDIS_PORT=6379
# For a Redis with ACLs or requirepass; empty for a local one.
XERMESS_REDIS_USERNAME=
XERMESS_REDIS_PASSWORD=
# The database number, 0-15 on a default server.
XERMESS_REDIS_DB=0
# Every key starts with this, so one Redis can serve several installations.
XERMESS_REDIS_PREFIX=xermess:
